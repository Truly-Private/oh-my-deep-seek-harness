# Optional override of the first-party profile shipped by the base bundle.
# Merge this section into $DSH_HOME/settings.yaml.
llm-pi-ai:
  providers:
    9router:
      displayName: 9Router
      apiKeyEnv: NINE_ROUTER_API_KEY
      api: openai-completions
      baseURL: http://127.0.0.1:20128/v1
      models:
        - id: trifecta
          name: Trifecta
