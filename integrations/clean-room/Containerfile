ARG BASE_IMAGE=ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea
FROM ${BASE_IMAGE} AS proto

ARG TARGETARCH
ARG PROTO_VERSION
ARG PROTO_SHA256_AMD64
ARG PROTO_SHA256_ARM64

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
    ca-certificates curl git xz-utils \
  && case "$TARGETARCH" in \
    amd64) proto_arch=x86_64; proto_sha="$PROTO_SHA256_AMD64" ;; \
    arm64) proto_arch=aarch64; proto_sha="$PROTO_SHA256_ARM64" ;; \
    *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 2 ;; \
  esac \
  && curl --fail --location --silent --show-error \
    "https://github.com/moonrepo/proto/releases/download/v${PROTO_VERSION}/proto_cli-${proto_arch}-unknown-linux-gnu.tar.xz" \
    --output /tmp/proto.tar.xz \
  && echo "${proto_sha}  /tmp/proto.tar.xz" | sha256sum --check --strict \
  && mkdir --parents /opt/proto/bin \
  && tar --extract --xz --file /tmp/proto.tar.xz --directory /opt/proto/bin \
    --strip-components=1 \
    "proto_cli-${proto_arch}-unknown-linux-gnu/proto" \
    "proto_cli-${proto_arch}-unknown-linux-gnu/proto-shim" \
  && chmod 0755 /opt/proto/bin/proto /opt/proto/bin/proto-shim \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/proto.tar.xz

ENV PROTO_HOME=/opt/proto
ENV PATH=/opt/proto/shims:/opt/proto/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /opt/harness

FROM proto AS node-toolchain
ARG NODE_VERSION
ARG BUN_VERSION
RUN proto install --yes --pin local node "$NODE_VERSION" \
  && proto install --yes --pin local bun "$BUN_VERSION" \
  && node --version \
  && bun --version
ENV PATH=/opt/proto/tools/node/${NODE_VERSION}/bin:/opt/proto/tools/bun/${BUN_VERSION}:/opt/proto/shims:/opt/proto/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

FROM node-toolchain AS pi
ARG PI_VERSION
ARG TSX_VERSION
ARG TYPEBOX_VERSION
COPY integrations/host-bridge /opt/bridge-source
RUN npm init --yes \
  && npm pkg set type=module private=true \
  && bridge_tarball="$(npm pack /opt/bridge-source --pack-destination /opt/harness --silent)" \
  && npm install --ignore-scripts --save-exact \
    "/opt/harness/${bridge_tarball}" \
    "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    "tsx@${TSX_VERSION}" \
    "typebox@${TYPEBOX_VERSION}" \
  && npm cache clean --force \
  && useradd --create-home --uid 10001 --shell /usr/sbin/nologin runner
COPY integrations/clean-room/pi-smoke.ts /opt/harness/pi-smoke.ts
ENV CLEANROOM_HOST_VERSION=${PI_VERSION}
USER runner
CMD ["node", "--import", "tsx/esm", "/opt/harness/pi-smoke.ts", "/opt/harness/node_modules/@truly-private/dsh-host-bridge/src/pi/index.ts", "/tmp/pi-profile", "/tmp/workspace"]

FROM node-toolchain AS omp
ARG OMP_VERSION
ARG TSX_VERSION
ARG TYPEBOX_VERSION
COPY integrations/host-bridge /opt/bridge-source
RUN bun init --yes \
  && bridge_tarball="$(npm pack /opt/bridge-source --pack-destination /opt/harness --silent)" \
  && bun add --ignore-scripts --exact \
    "/opt/harness/${bridge_tarball}" \
    "@oh-my-pi/pi-coding-agent@${OMP_VERSION}" \
    "tsx@${TSX_VERSION}" \
    "typebox@${TYPEBOX_VERSION}" \
  && rm -rf /root/.bun/install/cache \
  && useradd --create-home --uid 10001 --shell /usr/sbin/nologin runner
COPY integrations/clean-room/omp-smoke.mjs /opt/harness/omp-smoke.mjs
ENV CLEANROOM_HOST_VERSION=${OMP_VERSION}
ENV PI_CODING_AGENT_DIR=/tmp/omp-profile
USER runner
CMD ["node", "/opt/harness/omp-smoke.mjs"]

FROM node-toolchain AS hermes
ARG PYTHON_VERSION
ARG HERMES_VERSION
ARG ACP_SDK_VERSION
ARG TSX_VERSION
COPY integrations/host-bridge /opt/bridge
ENV PATH=/opt/proto/tools/python/${PYTHON_VERSION}/bin:${PATH}
RUN proto install --yes --pin local python "$PYTHON_VERSION" \
  && npm init --yes \
  && npm pkg set type=module private=true \
  && npm install --ignore-scripts --save-exact \
    "@agentclientprotocol/sdk@${ACP_SDK_VERSION}" \
    "tsx@${TSX_VERSION}" \
  && npm install --prefix /opt/bridge --ignore-scripts --omit=dev --no-save \
    "@agentclientprotocol/sdk@${ACP_SDK_VERSION}" \
  && npm cache clean --force \
  && python -m pip install --disable-pip-version-check --no-cache-dir "hermes-agent==${HERMES_VERSION}" \
  && hermes --help >/dev/null \
  && useradd --create-home --uid 10001 --shell /usr/sbin/nologin runner
COPY integrations/hermes-dsh /opt/hermes-plugin
COPY integrations/clean-room/hermes-smoke.py /opt/harness/hermes-smoke.py
ENV CLEANROOM_HOST_VERSION=${HERMES_VERSION}
USER runner
CMD ["python", "/opt/harness/hermes-smoke.py"]
