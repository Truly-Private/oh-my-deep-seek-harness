ARG BASE_IMAGE=ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea
FROM ${BASE_IMAGE} AS proto

ARG TARGETARCH
ARG PROTO_VERSION
ARG PROTO_SHA256_AMD64
ARG PROTO_SHA256_ARM64

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
    build-essential ca-certificates curl git xz-utils \
  && case "$TARGETARCH" in \
    amd64) proto_arch=x86_64; proto_sha="$PROTO_SHA256_AMD64" ;; \
    arm64) proto_arch=aarch64; proto_sha="$PROTO_SHA256_ARM64" ;; \
    *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 2 ;; \
  esac \
  && curl --fail --location --silent --show-error \
    "https://github.com/moonrepo/proto/releases/download/v${PROTO_VERSION}/proto_cli-${proto_arch}-unknown-linux-gnu.tar.xz" \
    --output /tmp/proto.tar.xz \
  && echo "${proto_sha}  /tmp/proto.tar.xz" | sha256sum --check --strict \
  && mkdir --parents /opt/proto/bin \
  && tar --extract --xz --file /tmp/proto.tar.xz --directory /opt/proto/bin \
    --strip-components=1 \
    "proto_cli-${proto_arch}-unknown-linux-gnu/proto" \
    "proto_cli-${proto_arch}-unknown-linux-gnu/proto-shim" \
  && chmod 0755 /opt/proto/bin/proto /opt/proto/bin/proto-shim \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/proto.tar.xz

ENV PROTO_HOME=/opt/proto
ENV PATH=/opt/proto/shims:/opt/proto/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /opt/bench

FROM proto AS toolchain
ARG NODE_VERSION
ARG PYTHON_VERSION
ARG PNPM_VERSION
RUN proto install --yes --pin local node "$NODE_VERSION" \
  && proto install --yes --pin local python "$PYTHON_VERSION" \
  && proto install --yes --pin local pnpm "$PNPM_VERSION" \
  && node --version \
  && python --version \
  && pnpm --version \
  && useradd --create-home --uid 10001 --shell /usr/sbin/nologin runner
ENV PATH=/opt/proto/tools/node/${NODE_VERSION}/bin:/opt/proto/tools/python/${PYTHON_VERSION}/bin:/opt/proto/tools/pnpm/${PNPM_VERSION}/bin:/opt/proto/shims:/opt/proto/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

FROM toolchain AS agent-common
ARG PI_VERSION
ARG TSX_VERSION
ARG TYPEBOX_VERSION
RUN npm init --yes \
  && npm pkg set type=module private=true \
  && npm install --ignore-scripts --save-exact \
    "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    "tsx@${TSX_VERSION}" \
    "typebox@${TYPEBOX_VERSION}" \
  && npm cache clean --force
COPY integrations/comparison-bench/pi-runner.ts integrations/comparison-bench/game-prompt.txt integrations/comparison-bench/harness-9router.cordis.yml /opt/bench/
WORKDIR /workspace

FROM agent-common AS pi-baseline
ENV COMPARISON_LANE=pi-baseline
USER runner
CMD ["node", "--import", "/opt/bench/node_modules/tsx/dist/esm/index.mjs", "/opt/bench/pi-runner.ts"]

FROM agent-common AS pi-harness
ARG PNPM_VERSION
COPY integrations/host-bridge /opt/bridge-source
COPY . /opt/dsh
RUN bridge_tarball="$(npm pack /opt/bridge-source --pack-destination /opt/bench --silent)" \
  && npm install --prefix /opt/bench --ignore-scripts --save-exact "/opt/bench/${bridge_tarball}" \
  && rm "/opt/bench/${bridge_tarball}" \
  && cd /opt/dsh \
  && CI=1 proto run pnpm -- install --frozen-lockfile \
  && npm cache clean --force \
  && proto run pnpm -- store prune \
  && install --directory --owner runner --group runner --mode 0700 /run/dsh-credentials
ENV COMPARISON_LANE=pi-harness
USER runner
CMD ["node", "--import", "/opt/bench/node_modules/tsx/dist/esm/index.mjs", "/opt/bench/pi-runner.ts"]

FROM toolchain AS evaluator
ARG PLAYWRIGHT_VERSION
USER root
WORKDIR /opt/bench
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN npm init --yes \
  && npm pkg set type=module private=true \
  && npm install --ignore-scripts --save-exact "playwright@${PLAYWRIGHT_VERSION}" \
  && npx playwright install --with-deps chromium \
  && npm cache clean --force
COPY integrations/comparison-bench/capture.mjs /opt/bench/capture.mjs
WORKDIR /workspace
USER runner
CMD ["node", "/opt/bench/capture.mjs"]
