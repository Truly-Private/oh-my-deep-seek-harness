{
  "name": "@truly-private/omdsh-api-remotes",
  "description": "Remote BFF assembly and Host Agent/Session lookup policy",
  "version": "0.0.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truly-Private/oh-my-deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@truly-private/omdsh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@truly-private/omdsh-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-agent-presets": "workspace:^",
    "@truly-private/omdsh-api-gateway": "workspace:^",
    "@truly-private/omdsh-commands": "workspace:^",
    "@truly-private/omdsh-cordis-host-runner": "workspace:^",
    "@truly-private/omdsh-credentials": "workspace:^",
    "@truly-private/omdsh-file-reference": "workspace:^",
    "@truly-private/omdsh-goal": "workspace:^",
    "@truly-private/omdsh-host-plugin-inventory": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-message-feedback": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-session-persistence": "workspace:^",
    "@truly-private/omdsh-session-reference": "workspace:^",
    "@truly-private/omdsh-settings": "workspace:^",
    "@truly-private/omdsh-typert-registry": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-agent-presets": "workspace:^",
    "@truly-private/omdsh-api-gateway": "workspace:^",
    "@truly-private/omdsh-commands": "workspace:^",
    "@truly-private/omdsh-cordis-host-runner": "workspace:^",
    "@truly-private/omdsh-credentials": "workspace:^",
    "@truly-private/omdsh-file-reference": "workspace:^",
    "@truly-private/omdsh-goal": "workspace:^",
    "@truly-private/omdsh-host-plugin-inventory": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-message-feedback": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-session-persistence": "workspace:^",
    "@truly-private/omdsh-session-reference": "workspace:^",
    "@truly-private/omdsh-settings": "workspace:^",
    "@truly-private/omdsh-typert-registry": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
