{
  "name": "@truly-private/omdsh-hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the DeepSeek Harness interception seams",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truly-Private/oh-my-deepseek-harness.git",
    "directory": "packages/hooks/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-hook-protocol": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-session-persistence": "workspace:^",
    "@truly-private/omdsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-agent-loop": "workspace:^",
    "@truly-private/omdsh-agent-loop-testkit": "workspace:^",
    "@truly-private/omdsh-shell": "workspace:^",
    "@truly-private/omdsh-bash-local": "workspace:^",
    "@truly-private/omdsh-subprocess-local": "workspace:^",
    "@truly-private/omdsh-hook-protocol": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-session-persistence": "workspace:^",
    "@truly-private/omdsh-session-persistence-jsonl": "workspace:^",
    "@truly-private/omdsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
