{
  "name": "@truly-private/omdsh-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truly-Private/oh-my-deepseek-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@truly-private/omdsh-attachment": "workspace:^",
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-agent-default-model": "workspace:^",
    "@truly-private/omdsh-api-remotes": "workspace:^",
    "@truly-private/omdsh-brand": "workspace:^",
    "@truly-private/omdsh-commands": "workspace:^",
    "@truly-private/omdsh-credentials": "workspace:^",
    "@truly-private/omdsh-goal": "workspace:^",
    "@truly-private/omdsh-host-directory-picker": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-native-command": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-session-persistence": "workspace:^",
    "@truly-private/omdsh-session-projection": "workspace:^",
    "@truly-private/omdsh-session-projection-cache": "workspace:^",
    "@truly-private/omdsh-session-query": "workspace:^",
    "@truly-private/omdsh-session-title": "workspace:^",
    "@truly-private/omdsh-settings": "workspace:^",
    "@truly-private/omdsh-skill": "workspace:^",
    "@truly-private/omdsh-subagent": "workspace:^",
    "@truly-private/omdsh-jobs": "workspace:^",
    "@truly-private/omdsh-tools": "workspace:^",
    "@truly-private/omdsh-user-approval": "workspace:^",
    "@truly-private/omdsh-user-questions": "workspace:^",
    "@truly-private/omdsh-workspace": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@truly-private/omdsh-agent-presets": "workspace:^",
    "@truly-private/omdsh-cordis-host-runner": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@truly-private/omdsh-agent-presets": "workspace:^",
    "@truly-private/omdsh-cordis-host-runner": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-storage": "workspace:^",
    "@truly-private/omdsh-storage-domain": "workspace:^",
    "@truly-private/omdsh-typert-protocol": "workspace:^",
    "@truly-private/omdsh-typert-registry": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
