{
  "name": "@truly-private/omdsh-schedule",
  "description": "Agent-scoped durable after, at, and fixed-rate reminders over the session event log",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truly-Private/oh-my-deepseek-harness.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-brand": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-session-persistence": "workspace:^",
    "@truly-private/omdsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-agent-loop": "workspace:^",
    "@truly-private/omdsh-agent-loop-testkit": "workspace:^",
    "@truly-private/omdsh-brand": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-session-persistence": "workspace:^",
    "@truly-private/omdsh-session-persistence-jsonl": "workspace:^",
    "@truly-private/omdsh-system-prompt": "workspace:^",
    "@truly-private/omdsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
