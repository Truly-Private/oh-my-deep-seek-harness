{
  "name": "@truly-private/omdsh-subagent-acp",
  "description": "Out-of-process ACP subagent backend: drives a child agent in a spawned subprocess over the Agent Client Protocol",
  "version": "0.0.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truly-Private/oh-my-deepseek-harness.git",
    "directory": "packages/subagent/subagent-acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-subagent": "workspace:^",
    "@truly-private/omdsh-subprocess": "workspace:^",
    "@truly-private/omdsh-timeout": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@truly-private/omdsh-agent": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-loader-smoke": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@truly-private/omdsh-subagent": "workspace:^",
    "@truly-private/omdsh-subprocess": "workspace:^",
    "@truly-private/omdsh-subprocess-local": "workspace:^",
    "@truly-private/omdsh-timeout": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
