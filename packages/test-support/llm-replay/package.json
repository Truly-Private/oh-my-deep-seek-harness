{
  "name": "@truly-private/omdsh-llm-replay",
  "description": "Replay LLM plugin: short-circuits llm/stream with model chunks reconstructed from a recorded session JSONL (keyless snapshot tests)",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truly-Private/oh-my-deepseek-harness.git",
    "directory": "packages/test-support/llm-replay"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@truly-private/omdsh-compaction": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@truly-private/omdsh-compaction": "workspace:^",
    "@truly-private/omdsh-invariants": "workspace:^",
    "@truly-private/omdsh-llm": "workspace:^",
    "@truly-private/omdsh-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
